  "title": "Fix \"Access Restricted\" gate blocking open-source local_deploy dashboards",
  "user": {
    "login": "sarthaknimbalkar",
    "id": 54149390,
    "node_id": "MDQ6VXNlcjU0MTQ5Mzkw",
